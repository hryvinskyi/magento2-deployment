# Magento 2 zero-downtime deployment - configuration
# Copy to .deploy.env in the Magento root (or run: ./deploy.sh --init)
# Priority: CLI flags > environment variables > this file > defaults

# Magento installation directory (absolute path; "." = directory of deploy.sh)
MAGENTO_DIR=/var/www/html

# PHP and Composer binaries
PHP_BIN=php
COMPOSER_BIN=composer

# PHP memory_limit for every CLI command (-1 = unlimited)
PHP_MEMORY_LIMIT=-1

# Frontend themes (comma-separated) and locales (space-separated)
FRONTEND_THEMES=Vendor/theme
FRONTEND_LANGUAGES=en_GB en_US de_DE

# Backend theme and locales
BACKEND_THEME=Magento/backend
BACKEND_LANGUAGES=en_US en_GB

# Parallel setup:static-content:deploy processes, one per (theme, locale).
# Default: number of CPU cores. Each process needs roughly 700 MB of RAM.
#PARALLEL_JOBS=8

# Extra options for every static-content:deploy process
#SCD_EXTRA_ARGS=--no-js-bundle

# setup:upgrade policy: auto (only when database changes are detected), always, never
DB_UPGRADE=auto

# Maintenance policy: auto (only while setup:upgrade runs), always, never
MAINTENANCE=auto

# IPs allowed to browse the site during maintenance (comma/space separated)
#MAINTENANCE_ALLOWED_IPS=203.0.113.10, 203.0.113.11

# Reset OPcache right after the artifact swap.
# REQUIRED when php-fpm runs with opcache.validate_timestamps=0.
#OPCACHE_RESET_CMD=sudo systemctl reload php8.3-fpm
#OPCACHE_RESET_CMD=cachetool opcache:reset --fcgi=/run/php/php8.3-fpm.sock

# Storefront URL checked after the release (expects HTTP 2xx)
#HEALTHCHECK_URL=https://www.example.com/
#HEALTHCHECK_RETRIES=3
#HEALTHCHECK_TIMEOUT=30

# Database backup before setup:upgrade (gzipped mysqldump into var/backups/)
#DB_BACKUP=true
#DB_BACKUP_CMD=

# Hook commands, executed in the Magento directory
#PRE_DEPLOY_CMD=git pull --ff-only
#POST_DEPLOY_CMD=curl -fsS https://www.example.com/ >/dev/null

# Build / previous-artifacts directory (same filesystem as pub/ and generated/)
#BUILD_DIR=var/deploy

# Keep the replaced artifacts in var/deploy/previous after a successful run
#KEEP_PREVIOUS=false

# Delete deploy logs, reports and backups older than N days (0 = never)
LOG_RETENTION_DAYS=30

# Default skips
#SKIP_COMPOSER=true
#SKIP_DB_CHECK=true
#SKIP_STATIC=true
#SKIP_DI_COMPILE=true

# Output: plain ASCII symbols / no colors
#DEPLOY_ASCII=true
#NO_COLOR=1
